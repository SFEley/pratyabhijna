# Vesper environment secrets.
# Copy to .env.dev, .env.test, or .env.prod and fill in real values.
# These files are gitignored — never commit actual keys.

# Neo4j
VESPER_NEO4J__PASSWORD=

# Anthropic (LLM)
VESPER_LLM__API_KEY=

# Voyage AI (embeddings)
VESPER_EMBEDDING__API_KEY=

# Embedding dimensions (Voyage 4 supports Matryoshka truncation)
EMBEDDING_DIM=512
