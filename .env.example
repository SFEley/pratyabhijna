# Pratyabhijna environment secrets.
# Copy to .env.dev, .env.test, or .env.prod and fill in real values.
# These files are gitignored — never commit actual keys.

# Server public URL (enables streamable-http transport and bearer auth).
# Leave empty for stdio transport (local Claude Code dev use).
PRATYABHIJNA_SERVER__URL=

# Bearer token for MCP auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when PRATYABHIJNA_SERVER__URL is set.
PRATYABHIJNA_API_KEY=

# Neo4j
PRATYABHIJNA_NEO4J__PASSWORD=

# Anthropic (LLM)
PRATYABHIJNA_LLM__API_KEY=

# Voyage AI (embeddings)
PRATYABHIJNA_EMBEDDING__API_KEY=

# Embedding dimensions (Voyage 4 supports Matryoshka truncation)
EMBEDDING_DIM=512
